  {
   "id": "HLDfwvMIYJEfllBYwEsX",
   "type": "text",
   "x": 2228,
   "y": 1941.25,
   "width": 958.8,
   "height": 127.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
