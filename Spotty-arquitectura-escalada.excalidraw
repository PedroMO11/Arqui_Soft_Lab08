  {
   "id": "UWZQVYauP3QDeWrDvXM3",
   "type": "text",
   "x": 988,
   "y": 1495.0,
   "width": 877.1999999999999,
   "height": 170.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1672746507,
   "version": 1,
   "versionNonce": 1372429863,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1761100000000,
   "link": null,
   "locked": false,
   "text": "Spot interruption (2-minute notice)\n• Interruption Handler receives the notice and sends SIGTERM to the sandbox\n• Programming (P99 ≤ 1 min): the job finishes within the notice\n• Architecture (P99 ≤ 10 min): finishes, or is re-enqueued in the Priority Queue\n• AI GPU (≥ 40 min): Checkpoint Manager saves state to S3, job resumes on another node\n• If a node dies without notice, the queue redelivers the message (visibility timeout)\n• Max. 3 infrastructure retries → Dead Letter Queue\n• Student OOM / timeout is a grade, never retried",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rD7IDdshnLFHjiZvaBwq",
   "originalText": "Spot interruption (2-minute notice)\n• Interruption Handler receives the notice and sends SIGTERM to the sandbox\n• Programming (P99 ≤ 1 min): the job finishes within the notice\n• Architecture (P99 ≤ 10 min): finishes, or is re-enqueued in the Priority Queue\n• AI GPU (≥ 40 min): Checkpoint Manager saves state to S3, job resumes on another node\n• If a node dies without notice, the queue redelivers the message (visibility timeout)\n• Max. 3 infrastructure retries → Dead Letter Queue\n• Student OOM / timeout is a grade, never retried",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "WHFki7mv7aC75dm2KdDf",
   "type": "rectangle",
   "x": 1940,
   "y": 1420,
