  {
   "id": "jceK1aAEHlMnjdqoD7St",
   "type": "text",
   "x": 2908,
   "y": 1473.75,
   "width": 856.8,
   "height": 212.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
